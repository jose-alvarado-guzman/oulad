# Template for src/.env, the local fallback credential source. Copy to
# src/.env and fill in the values. In Colab these are read from the notebook
# Secrets panel instead and this file is not needed. See oulad/credentials.py.
#
# The keys come in two required groups: the ETL group, needed to load the graph,
# and the Aura Graph Analytics (AGA) group, needed to analyse it afterwards.
# Each group is enforced only by the code that uses it, so the ETL runs without
# the AGA keys and the analytics run without a fresh load.

# ETL group. Required by the loading pipeline (credentials.ETL_SECRETS).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Aura Graph Analytics group. Required by the analytics and never read by the
# ETL (credentials.AGA_SECRETS).
AURA_CLIENT_SECRET=
AURA_CLIENT_ID=
AURA_PROJECT_ID=

# Required by neither group. The post-load QA queries fall back to the neo4j
# default when this is unset; set it explicitly for the analytics.
NEO4J_DATABASE=

# Also optional. The graph analytics session attaches to this AuraDB instance,
# but the id is the first label of NEO4J_URI, so credentials.aura_instance_id
# derives it when this is blank. Set it only if NEO4J_URI is a custom hostname.
AURA_INSTANCEID=
